.vscode/settings.json

# host test binaries
test/mirror_test
test/sync_gate_test
test/*.dSYM/

# FPP headers extracted at test time from a local FPP checkout (LGPL, not
# vendored) — see test/fppapi/PROVENANCE
test/fppapi/v*/

# Runtime artifacts the plugin writes into its own checkout.  FPP's upgrade
# fallback runs `git clean -fd` here, which would delete the live connector
# binary if these stayed untracked-and-unignored.
/pulsemesh-connector
/pulsemesh-connector.pid
/pulsemesh_version*.txt
/libfpp-PulseMesh.*
src/*.o
